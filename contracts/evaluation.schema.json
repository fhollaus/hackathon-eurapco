{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "team_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "handling_agent": {
      "enum": [
        "administration",
        "claims",
        null
      ]
    },
    "request_category": {
      "enum": [
        "policy_enquiry",
        "contact_update",
        "coverage_change",
        "policy_termination",
        "out_of_scope_iban",
        "out_of_scope_renewal",
        "out_of_scope_claims",
        "out_of_scope_other",
        "unclear",
        "reimbursement_request",
        "claim_enquiry",
        "out_of_scope_claim_integration",
        "out_of_scope_administration",
        null
      ]
    },
    "agent_state": {
      "enum": [
        "processing",
        "awaiting_clarification",
        "awaiting_authorization",
        "completed",
        "closed_without_execution",
        "failed"
      ]
    },
    "request_outcome": {
      "enum": [
        "in_progress",
        "information_requested",
        "authorization_requested",
        "answered",
        "updated",
        "terminated",
        "paid",
        "no_change",
        "duplicate",
        "not_covered",
        "inactive_policy",
        "outside_coverage_period",
        "not_insured",
        "out_of_scope",
        "unclear",
        "insufficient_information",
        "insurer_rejected",
        "zero_reimbursement",
        "invalid_input",
        "technical_failure",
        "handover_required"
      ]
    },
    "reason": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "human_rounds": {
      "type": "object",
      "properties": {
        "clarification": {
          "type": "integer",
          "minimum": 0
        },
        "authorization": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "clarification",
        "authorization"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": [
              "input",
              "routing",
              "tool_call",
              "tool_result",
              "model_response",
              "status",
              "error",
              "handover"
            ]
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "sequence",
          "timestamp",
          "kind",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "domain_snapshot": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "team_id",
    "run_id",
    "ticket_id",
    "policy_id",
    "handling_agent",
    "request_category",
    "agent_state",
    "request_outcome",
    "reason",
    "message",
    "human_rounds",
    "events",
    "domain_snapshot"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "agent_state": {
            "enum": [
              "awaiting_clarification",
              "awaiting_authorization",
              "completed",
              "closed_without_execution"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "handling_agent": {
            "type": "string"
          },
          "request_category": {
            "type": "string"
          }
        }
      }
    }
  ]
}
