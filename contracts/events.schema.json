{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "event_type": {
          "const": "request"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "author_name": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "invoice_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "prescription_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "event_id",
        "ticket_id",
        "timestamp",
        "event_type",
        "policy_id",
        "author_name",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "event_type": {
          "const": "clarification_reply"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "invoice_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "prescription_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "event_id",
        "ticket_id",
        "timestamp",
        "event_type",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "event_type": {
          "const": "insurer_decision"
        },
        "decision": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "event_id",
        "ticket_id",
        "timestamp",
        "event_type",
        "decision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "reject"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  ]
}
